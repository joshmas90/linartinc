<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # One-hop canonical scheme + host.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^linartinc\.com$ [NC]
  RewriteRule ^ https://linartinc.com%{REQUEST_URI} [L,R=301,NE]

  # Never hand crawler files, the form handler, or the error shell to routing.
  RewriteRule ^contact\.php$ - [L]
  RewriteRule ^(robots\.txt|sitemap\.xml|llms\.txt|404\.html)$ - [L]

  # Canonicalize trailing slashes except the site root.
  RewriteCond %{REQUEST_URI} !^/$
  RewriteCond %{REQUEST_URI} /$
  RewriteRule ^(.+?)/$ /$1 [L,R=301,NE]

  # Keep public URLs extensionless.
  RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]|$) [NC]
  RewriteRule ^index\.html$ / [L,R=301,NE]

  RewriteCond %{THE_REQUEST} \s/+.+\.html(?:[?\s]|$) [NC]
  RewriteRule ^(.+)\.html$ /$1 [L,R=301,NE]

  # Serve any generated route shell when a matching .html file exists.
  # This supports top-level routes and nested service routes without a
  # hand-maintained rewrite list.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # Unknown public URLs are real 404s, not homepage-style soft 404s.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ - [R=404,L]
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/json application/xml \
    image/svg+xml application/ld+json
</IfModule>

<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=0, must-revalidate"

  <If "%{REQUEST_URI} =~ m#^/assets/.*$#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  <If "%{REQUEST_URI} =~ m#^/(images|branding)/.*$#">
    Header set Cache-Control "public, max-age=2592000"
  </If>

  <If "%{REQUEST_URI} =~ m#^/(contact|studio|studio-admin|studio-runtime)\.php$#">
    Header set Cache-Control "no-store"
  </If>

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always unset X-Powered-By
  Header unset X-Powered-By
</IfModule>

<FilesMatch "\.(log)$">
  Require all denied
</FilesMatch>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType application/xml .xml
</IfModule>
